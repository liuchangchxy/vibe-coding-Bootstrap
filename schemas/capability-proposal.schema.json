{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/capability-proposal.schema.json",
  "title": "Capability Improvement Proposal",
  "description": "A human-reviewed change request. current_version is the target Capability's actual version when this proposal is created; it never changes a Capability record by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "target_capability", "current_version", "proposed_change", "reason", "evidence", "affected_scope", "risk", "approval_status"],
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1 },
    "source_experience_proposals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "target_capability": { "type": "string", "minLength": 1 },
    "current_version": { "type": "string", "minLength": 1 },
    "proposed_change": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "evidence.schema.json" } },
    "affected_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risk": { "type": "string", "minLength": 1 },
    "approval_status": { "enum": ["pending", "approved", "rejected", "deferred"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "approval_notes": { "type": "string" },
    "approved_change_reference": { "type": "string", "minLength": 1 }
  },
  "allOf": [{
    "if": { "properties": { "approval_status": { "enum": ["approved", "rejected"] } }, "required": ["approval_status"] },
    "then": { "required": ["reviewer", "reviewed_at"] }
  }]
}
