{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "A traceable observation supporting or limiting an Experience or proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "source", "description", "strength", "verification"],
  "properties": {
    "type": { "enum": ["project_result", "ci_result", "reviewer_confirmation", "measured_benefit", "ai_judgment", "single_attempt", "other"] },
    "source": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "strength": { "enum": ["weak", "moderate", "strong"] },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unverified", "checked", "independently_confirmed"] },
        "method": { "type": "string", "minLength": 1 },
        "verified_by": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "limits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
