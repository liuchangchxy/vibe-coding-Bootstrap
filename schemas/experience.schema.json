{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/experience.schema.json",
  "title": "Experience",
  "description": "A project-specific account and evidence record. Lifecycle metadata is optional for compatibility with Phase 1 records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "project_context", "approach", "outcome", "evidence", "confidence", "recorded_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_type", "goal"],
      "properties": {
        "project_type": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "technologies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "approach": { "type": "string", "minLength": 1 },
    "capability_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "result"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "result": { "enum": ["success", "mixed", "failure", "inconclusive"] },
        "measures": { "type": "array", "items": { "$ref": "#/$defs/measure" } }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "anyOf": [{ "$ref": "evidence.schema.json" }, { "$ref": "#/$defs/legacyEvidence" }] }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "lesson": { "type": "string", "description": "A cautious, reusable takeaway, including known limits." },
    "recorded_by": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "identity": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "recorded_by"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "recorded_by": { "type": "string", "minLength": 1 },
        "record_uri": { "type": "string", "format": "uri-reference" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "context": { "type": "string", "minLength": 1 },
    "observation": { "type": "string", "minLength": 1 },
    "solution": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reasoning": {
      "type": "object", "additionalProperties": false,
      "required": ["interpretation", "limits"],
      "properties": {
        "interpretation": { "type": "string", "minLength": 1 },
        "limits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "status": { "enum": ["raw", "candidate", "verified", "rejected", "archived"] },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["review_status"],
      "properties": {
        "review_status": { "enum": ["pending", "accepted", "rejected"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["status"] },
      "then": { "properties": { "evidence": { "items": { "$ref": "evidence.schema.json" } } } }
    },
    {
      "if": { "properties": { "status": { "const": "candidate" } }, "required": ["status"] },
      "then": { "required": ["identity", "source", "context", "observation", "solution", "scope", "reasoning"] }
    },
    {
      "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
      "then": {
        "required": ["identity", "source", "context", "observation", "solution", "scope", "reasoning", "review"],
        "properties": {
          "review": { "required": ["reviewer", "reviewed_at"], "properties": { "review_status": { "const": "accepted" } } },
          "evidence": { "contains": {
            "type": "object",
            "required": ["type", "strength", "verification"],
            "properties": {
              "type": { "not": { "enum": ["ai_judgment", "single_attempt"] } },
              "strength": { "enum": ["moderate", "strong"] },
              "verification": { "properties": { "status": { "enum": ["checked", "independently_confirmed"] } } }
            }
          } }
        }
      }
    }
  ],
  "$defs": {
    "legacyEvidence": {
      "type": "object", "additionalProperties": false, "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri-reference" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "string", "boolean"] },
        "unit": { "type": "string", "minLength": 1 },
        "context": { "type": "string" }
      }
    }
  }
}
