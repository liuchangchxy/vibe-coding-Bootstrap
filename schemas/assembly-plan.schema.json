{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/assembly-plan.schema.json",
  "title": "Environment Assembly Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_context", "recommendation_source", "selected_capabilities", "components", "skipped_components", "unresolved_conflicts", "warnings", "requires_confirmation", "generated_at"],
  "properties": {
    "project_context": {"$ref": "project-context.schema.json"},
    "recommendation_source": {"type": "string", "minLength": 1},
    "selected_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "components": {"type": "array", "items": {"$ref": "#/$defs/assembly_item"}},
    "skipped_components": {"type": "array", "items": {"$ref": "#/$defs/assembly_item"}},
    "unresolved_conflicts": {"type": "array", "items": {"type": "object", "required": ["kind", "items", "reason"], "properties": {"kind": {"enum": ["capability", "component", "scope", "delivery"]}, "items": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requires_confirmation": {"const": true},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "assembly_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_type", "source_capability", "reason", "scope", "source", "delivery", "action", "configuration_preview", "dependencies", "conflicts"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_type": {"enum": ["skill", "mcp", "rule", "prompt", "template", "document", "workflow_reference"]},
        "source_capability": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "scope": {"enum": ["global", "project", "external"]},
        "source": {"type": "string", "minLength": 1},
        "delivery": {"enum": ["reference", "copy", "symlink", "native_install", "generated"]},
        "action": {"enum": ["include", "skip", "review_required"]},
        "configuration_preview": {"type": "object"},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
