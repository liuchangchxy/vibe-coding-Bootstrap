{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/bootstrap-decision.schema.json",
  "title": "Unified Bootstrap Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "plan_digest", "target_commit_sha", "decision", "confirmed_at"],
  "properties": {
    "format_version": {"const": 1},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision": {"enum": ["approve", "reject"]},
    "confirmed_at": {"type": "string", "format": "date-time"}
  }
}
