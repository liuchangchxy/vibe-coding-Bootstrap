{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/capability.schema.json",
  "title": "Capability",
  "description": "A reusable development ability and the highest-level reuse abstraction. One or more components express it; kind is a Phase 1 compatibility field, not a taxonomy or authoritative description of component types.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "description",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier chosen by the capability catalog owner."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "skill",
        "mcp",
        "rule",
        "prompt",
        "template",
        "documentation",
        "workflow"
      ],
      "description": "Legacy primary-representation hint retained for Phase 1 compatibility. It is not a Capability taxonomy, does not identify the sole component type, and does not constrain components. Composite Capabilities may use workflow; actual component types come from components and assembly metadata. New logic must not infer component types from this field."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "deprecated"
      ]
    },
    "source": {
      "type": "string",
      "format": "uri-reference",
      "description": "Origin of the capability description; component provenance is recorded separately in component_sources."
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "project_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technologies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "IDs of prerequisite capabilities."
    },
    "conflicts_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "IDs of capabilities known to conflict with this one."
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "experience_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "IDs of Experience records that provide evidence about this capability."
    },
    "category": {
      "enum": [
        "engineering",
        "workflow",
        "quality",
        "research",
        "agent",
        "automation",
        "delivery",
        "domain"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_when",
        "not_for"
      ],
      "properties": {
        "use_when": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "not_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "maturity": {
      "enum": [
        "experimental",
        "established"
      ],
      "description": "Stability of the capability definition, independent of evidence and catalog review status."
    },
    "related_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional, advisory capability IDs; never prerequisites or automatic selections."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "role",
          "source_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "skill",
              "mcp",
              "rule",
              "prompt",
              "template",
              "documentation",
              "workflow"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "assembly": {
            "$ref": "component.schema.json"
          }
        }
      }
    },
    "component_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "uri",
          "relationship"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "relationship": {
            "enum": [
              "reference",
              "upstream"
            ]
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "selection_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals",
        "constraints"
      ],
      "properties": {
        "signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "supported"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "supported"
              }
            }
          },
          "then": {
            "required": [
              "references"
            ]
          }
        }
      ]
    }
  }
}
