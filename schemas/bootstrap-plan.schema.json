{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-bootstrap.local/schemas/bootstrap-plan.schema.json",
  "title": "Unified Bootstrap Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "target", "host", "route", "project_context", "catalog_revision", "profile_sha256", "capabilities", "project_changes", "global_changes", "references", "host_activations", "unchanged", "unresolved", "warnings", "underlying_plans", "requires_confirmation", "actual_changes", "executable", "global_root", "conflicts", "generated_at", "plan_digest"],
  "properties": {
    "format_version": {"const": 1},
    "target": {"type": "object", "required": ["commit_sha", "dirty", "path"], "properties": {"repository": {"type": ["string", "null"]}, "branch": {"type": ["string", "null"]}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "remote": {"type": ["string", "null"]}, "remote_commit_sha": {"type": ["string", "null"]}, "dirty": {"type": "boolean"}, "path": {"type": "string"}, "additionalProperties": false}, "additionalProperties": false},
    "host": {"type": "string"}, "route": {"enum": ["compose", "adoption"]},
    "project_context": {"type": ["object", "null"]}, "catalog_revision": {"type": "string"}, "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "project_changes": {"$ref": "#/$defs/changeList"}, "global_changes": {"$ref": "#/$defs/changeList"},
    "references": {"type": "array", "items": {"type": "string"}}, "host_activations": {"type": "array", "items": {"type": "object"}},
    "unchanged": {"type": "array", "items": {"type": "string"}}, "unresolved": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}, "underlying_plans": {"type": "object"},
    "requires_confirmation": {"type": "boolean"}, "actual_changes": {"type": "integer", "minimum": 0}, "executable": {"type": "boolean"},
    "global_root": {"type": ["string", "null"]}, "conflicts": {"$ref": "#/$defs/changeList"}, "generated_at": {"type": "string", "format": "date-time"}, "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {"changeList": {"type": "array", "items": {"type": "object", "required": ["component_id", "source_capability", "scope", "delivery", "result"], "properties": {"component_id": {"type": "string"}, "source_capability": {"type": "string"}, "scope": {"enum": ["project", "global"]}, "delivery": {"enum": ["copy", "reference"]}, "destination": {"type": "string"}, "result": {"enum": ["copied", "upgraded", "unchanged", "conflict", "unsupported", "reference_only", "skipped"]}, "reason": {"type": "string"}, "sha256": {"type": "string"}, "old_sha256": {"type": "string"}, "old_version": {"type": "string"}, "new_version": {"type": "string"}, "delta": {"type": "string"}}, "additionalProperties": false}}}
}
